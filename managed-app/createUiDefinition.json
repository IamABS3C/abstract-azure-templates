{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "<img src=\"data:image/svg+xml;base64,\" width=\"75px\" height=\"75px\">\n\n**Abstract Security** — the Security Data Pipeline Platform.\n\nThis Microsoft Sentinel solution makes Abstract-delivered data discoverable and actionable: a branded **data connector** tile, an **ASIM parser**, an **analytics rule**, two **hunting queries**, a **pipeline-overview workbook**, two **SOAR playbooks**, and a **Security Copilot** plugin + agent — all wired to the Abstract API so you can triage in Sentinel and act on the pipeline in Abstract.\n\n[Abstract Security](https://abstract.security) · [Documentation](https://docs.abstractsecurity.app)",
        "subscription": {
          "resourceProviders": ["Microsoft.OperationalInsights/workspaces", "Microsoft.Insights/workbooks", "Microsoft.SecurityInsights/dataConnectorDefinitions"]
        },
        "location": { "metadata": { "hidden": "Hiding location, we get it from the log analytics workspace" }, "visible": false }
      }
    },
    "basics": [
      {
        "name": "workspace",
        "type": "Microsoft.Common.TextBox",
        "label": "Workspace name",
        "placeholder": "AbstractWorkspace",
        "toolTip": "Name of the Log Analytics workspace where Microsoft Sentinel is enabled and where the Abstract custom table (AbstractEventLogs_CL) lives.",
        "constraints": {
          "required": true,
          "regex": "^[A-Za-z0-9][A-Za-z0-9-]{2,61}[A-Za-z0-9]$",
          "validationMessage": "Enter the existing workspace name (4-63 chars)."
        }
      }
    ],
    "steps": [
      {
        "name": "analytics",
        "label": "Analytics & Hunting",
        "elements": [
          {
            "name": "analytics-text",
            "type": "Microsoft.Common.TextBlock",
            "options": { "text": "Installs two scheduled analytics rules — 'Abstract - High or Critical event' (surfaces AbstractInsightId for the Verdict playbook) and 'Abstract - Repeated auth failures followed by success' (brute-force / password-spray) — the ASim_AbstractEvent parser, and two hunting queries (rare product, high cumulative-risk identities)." }
          }
        ]
      },
      {
        "name": "connectorworkbook",
        "label": "Connector & Workbook",
        "elements": [
          {
            "name": "cw-text",
            "type": "Microsoft.Common.TextBlock",
            "options": { "text": "Installs the Abstract Security data connector tile (live ingestion-status graph) and the Pipeline Overview workbook (volume, coverage, and a reduction/cost estimate)." }
          },
          {
            "name": "cw-ingestion-text",
            "type": "Microsoft.Common.TextBlock",
            "options": { "text": "This wizard installs the in-workspace content (connector tile, workbook, analytics, hunts, playbooks). Deploy the Abstract ingestion stack (Data Collection Endpoint + Data Collection Rule + AbstractEventLogs_CL) separately with the Sentinel Destination template — the one-click 'Deploy to Azure' variant in the solution repo provisions the DCE and DCR this connector and workbook read from." }
          },
          {
            "name": "cw-rbac-info",
            "type": "Microsoft.Common.InfoBox",
            "options": { "icon": "Warning", "text": "Enterprise prerequisite — Entra app registration (RBAC): Abstract publishes events to the Sentinel DCR through an Entra ID app registration and its service principal. Azure Resource Manager cannot create the app registration, so create it in Entra ID first, then grant its service principal BOTH 'Monitoring Metrics Publisher' AND 'Monitoring Contributor' scoped to the Data Collection Rule — not the subscription or resource group. Scoping both roles to the DCR is the least-privilege posture: it is the only identity the pipeline needs, and it can do nothing beyond publishing to that rule. Store the client secret in Azure Key Vault." }
          }
        ]
      },
      {
        "name": "automation",
        "label": "Playbooks & Copilot",
        "elements": [
          {
            "name": "auto-text",
            "type": "Microsoft.Common.TextBlock",
            "options": { "text": "Installs three Logic App playbooks — Enrich Incident, Verdict (agentic), and Tune-at-source — that call the Abstract API to close the loop. Provide the Abstract credentials below to wire them up now, or leave them blank and configure the API connection (ideally via Key Vault) after install. The Security Copilot plugin/agent ship in the solution source (solution/copilot)." }
          },
          {
            "name": "abstractBaseUrl",
            "type": "Microsoft.Common.TextBox",
            "label": "Abstract API base URL",
            "defaultValue": "https://api.abstractsecurity.app",
            "toolTip": "Abstract API base URL the playbooks call.",
            "constraints": { "required": false, "regex": "^https://.+", "validationMessage": "Enter an https URL." }
          },
          {
            "name": "abstractVendorAccountId",
            "type": "Microsoft.Common.TextBox",
            "label": "Abstract vendor account id (optional)",
            "toolTip": "Sent as the x-as-vendor-account-id header. Leave blank to configure later.",
            "constraints": { "required": false }
          },
          {
            "name": "abstractApiKey",
            "type": "Microsoft.Common.PasswordBox",
            "label": { "password": "Abstract API key (optional)", "confirmPassword": "Confirm Abstract API key" },
            "toolTip": "Bearer token for the Abstract API. Stored as a secure parameter. Leave blank to configure via Key Vault after install.",
            "options": { "hideConfirmation": true },
            "constraints": { "required": false }
          },
          {
            "name": "auto-info",
            "type": "Microsoft.Common.InfoBox",
            "options": { "icon": "Info", "text": "The key is passed as a securestring and is never stored in the template. For production, leave it blank here and reference Azure Key Vault from the playbook connection. After install, authorize each playbook's Microsoft Sentinel API connection and attach the playbooks via automation rules." }
          }
        ]
      }
    ],
    "outputs": {
      "workspace-location": "[location()]",
      "location": "[location()]",
      "workspace": "[basics('workspace')]",
      "abstractBaseUrl": "[steps('automation').abstractBaseUrl]",
      "abstractVendorAccountId": "[steps('automation').abstractVendorAccountId]",
      "abstractApiKey": "[steps('automation').abstractApiKey]"
    }
  }
}
